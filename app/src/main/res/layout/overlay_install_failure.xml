<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/install_failure_backdrop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B8180A1E"
    android:clickable="true"
    android:focusable="true">

    <!-- Rayos y chispas cartoon de aviso detrás de la tarjeta -->
    <es.girarkas.giraquest.ui.CartoonFailureView
        android:id="@+id/cartoon_failure_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Tarjeta cómic centrada -->
    <LinearLayout
        android:id="@+id/cartoon_fail_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_cartoon_fail_card"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:maxWidth="390dp"
        android:minWidth="300dp"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="16dp"
        android:paddingEnd="22dp"
        android:paddingBottom="18dp">

        <!-- Sello cómic inclinado -->
        <TextView
            android:id="@+id/tv_cartoon_fail_stamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_cartoon_fail_stamp"
            android:paddingStart="16dp"
            android:paddingTop="5dp"
            android:paddingEnd="16dp"
            android:paddingBottom="5dp"
            android:rotation="-5"
            android:text="@string/install_failure_badge"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Mascota cartoon mareada/fallo -->
        <ImageView
            android:id="@+id/iv_cartoon_fail_mascot"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginTop="4dp"
            android:contentDescription="@string/install_failure_badge"
            android:scaleType="fitCenter"
            android:src="@drawable/cartoon_fail_mascot" />

        <!-- Nombre del juego -->
        <TextView
            android:id="@+id/tv_cartoon_fail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/gira_ink"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- Frase divertida cartoon -->
        <TextView
            android:id="@+id/tv_cartoon_fail_funny"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="#B91C1C"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Caja con el motivo real del fallo -->
        <TextView
            android:id="@+id/tv_cartoon_fail_reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#1AFF3B6B"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="5"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:textColor="#3B1D36"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_cartoon_fail_ok"
            style="@style/Widget.GiraQuest.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="42dp"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:text="@string/install_failure_btn" />
    </LinearLayout>

</FrameLayout>
