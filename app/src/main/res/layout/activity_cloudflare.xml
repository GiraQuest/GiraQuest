<?xml version="1.0" encoding="utf-8"?>
<!-- Pase de Cloudflare (v0.1.10): el WebView arranca oculto (1x1 px) y solo
     se hace visible si el challenge pide interacción humana. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_cf_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cf_checking"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/cf_tap_checkbox"
        android:textSize="16sp" />

    <ProgressBar
        android:id="@+id/progress_cf"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:indeterminate="true" />

    <WebView
        android:id="@+id/webview_cf"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="invisible" />

</LinearLayout>
