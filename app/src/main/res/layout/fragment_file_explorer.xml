<?xml version="1.0" encoding="utf-8"?>
<!-- Explorador de archivos propio de GiraQuest (v0.1.28): sin selector
     del sistema ni gestores externos. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tab_title_files"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tab_files_info"
        android:textSize="13sp" />

    <!-- Sin permiso de archivos: aviso + botón para concederlo. -->
    <LinearLayout
        android:id="@+id/card_files_perm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_perm_card"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/files_perm_text"
            android:textColor="@color/gira_ink"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_files_grant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/perm_btn_files" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_files_free"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_files_new_folder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/files_new_folder"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Accesos rápidos. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_quick_downloads"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/files_quick_downloads"
                android:textSize="13sp" />
            <Button
                android:id="@+id/btn_quick_giraquest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:minWidth="0dp"
                android:text="@string/files_quick_giraquest"
                android:textSize="13sp" />
            <Button
                android:id="@+id/btn_quick_obb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:minWidth="0dp"
                android:text="@string/files_quick_obb"
                android:textSize="13sp" />
            <Button
                android:id="@+id/btn_quick_data"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:minWidth="0dp"
                android:text="@string/files_quick_data"
                android:textSize="13sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Miga de pan. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/breadcrumb_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Buscador + orden. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_files_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/files_search_hint"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_sort_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:text="@string/files_sort_name"
            android:textSize="13sp" />
        <Button
            android:id="@+id/btn_sort_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:text="@string/files_sort_size"
            android:textSize="13sp" />
        <Button
            android:id="@+id/btn_sort_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:text="@string/files_sort_date"
            android:textSize="13sp" />
        <Button
            android:id="@+id/btn_files_hidden"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:text="@string/files_show_hidden"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Barra de "pegar": elegir carpeta destino para copiar/mover. -->
    <LinearLayout
        android:id="@+id/bar_files_pick"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_perm_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_files_pick_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/gira_ink"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_files_paste"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/files_paste_here"
            android:textSize="13sp" />
        <Button
            android:id="@+id/btn_files_pick_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:text="@string/cancel"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Barra de selección múltiple. -->
    <LinearLayout
        android:id="@+id/bar_files_select"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_perm_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_files_sel_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/gira_ink"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_files_copy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/files_copy"
            android:textSize="13sp" />
        <Button
            android:id="@+id/btn_files_move"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:text="@string/files_move"
            android:textSize="13sp" />
        <Button
            android:id="@+id/btn_files_rename"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:text="@string/files_rename"
            android:textSize="13sp" />
        <Button
            android:id="@+id/btn_files_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:text="@string/files_delete"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- La carpeta no se puede listar con File API: concederla por SAF
         (v0.1.29). Solo visible cuando el listado falló. -->
    <Button
        android:id="@+id/btn_files_grant_folder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/grant_obb_folder"
        android:textSize="13sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_files"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tv_files_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/files_empty"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>
